variable {R X Y V A M N : Type*}

open Convexity

section Semiring

variable [Semiring R] [PartialOrder R] [IsStrictOrderedRing R] [ConvexSpace R M] [ConvexSpace R N]
variable [ConvexSpace R X]
variable {P P₁ P₂ s : Set X}

variable (R) in
def IsPolytope (s : Set X) : Prop := ∃ t : Finset X, s = Convexity.convexHull R t

/- Exercise 1: Given the definition of a polytope,
show that the empty set is a polytope -/
lemma empty_isPolytope : IsPolytope (R:=R) (X:=X) (∅ : Set X) := by
  use ∅
  simp

/- Exercise 2: Define the unit square as the convex hull
of its vertices in the convex space  and show that is a polytope -/
def vertices : Finset (ℚ × ℚ) := {(0, 0), (1,0), (0,1), (1,1)}

def unitSquare : Set (ℚ × ℚ) :=
  Convexity.convexHull ℚ vertices

theorem unitSquare_isPolytope : IsPolytope (R:=ℚ) (X:= ℚ × ℚ) unitSquare := by
  unfold unitSquare
  use vertices

/- Exercise 3: Show that polytopes are convex sets -/
lemma Polytope_isConvexSet (hP : IsPolytope R P) : IsConvexSet R P := by
  unfold IsPolytope at hP
  unfold IsConvexSet
  intro w hw
  obtain ⟨t, rfl⟩ := hP
  exact IsConvexSet.convexHull hw
